# Settings of slurm/precession/submit.sh and job.sh. Copy to cluster.env (not
# committed) and edit. The jobs source this file too: module loads and
# exports go here.
# Find your accounts and partitions with
#   sacctmgr show assoc user=$USER format=account%20,partition%15,qos%30
#   sinfo -s

SLURM_ACCOUNT=""            # -A; empty if your cluster has no accounts
SLURM_PARTITION=""          # -p; empty for the default partition
SLURM_EXTRA=""              # any other sbatch options, e.g. "--qos=long --mail-type=FAIL"

# Where the datasets, regressors and logs go (65 kB a training binary: 68 GB
# for 2^20), on a filesystem every node sees: scratch, not home.
DATA="$PWD/visualization/precession_scale/run"

# The python of the project's environment (uv sync --extra jax), called
# directly so that signals reach it.
PYTHON=".venv/bin/python"

# SLURM signals the jobs this many seconds before their walltime: they
# checkpoint (or abandon the shard they are making) and are requeued, at most
# MAX_REQUEUES times each.
SIGNAL_LEAD=300
MAX_REQUEUES=20

# -- the datasets --------------------------------------------------------------
N_TRAIN=1048576             # 2^20
N_VALIDATION=16384          # 2^14, independent (another seed)
SHARD_SIZE=4096
MASS_RATIO="1 1.5"          # q range of both; the study so far is q <= 1.5
SMOOTHING=1e-2              # AngleGrid.smoothing of the envelopes

# making the shards: tasks x cpus processes claim shards until none is left
# (~25-40 ms a binary a core: 2^20 is ~10 core-hours)
GENERATE_TASKS=8
GENERATE_CPUS=32
GENERATE_MEM=32G
GENERATE_TIME=04:00:00

# the waveforms of the validation set with integrated angles, once (~30 ms a
# binary: the integration is sequential, more cores barely help)
EXACT_CPUS=8
EXACT_MEM=16G
EXACT_TIME=04:00:00

# refinement of the envelopes (refine_envelopes): REFINE_ITERATIONS rounds of
# FOLDS kernel-ridge priors on PRIOR_SIZE binaries of the other folds each
# (~20 minutes and ~8 GB for 2^14), then refits of every binary (~5 ms each)
REFINE_ITERATIONS=2
FOLDS=4
PRIOR_SIZE=16384
PRIOR_CPUS=16
PRIOR_MEM=16G
PRIOR_TIME=02:00:00

# -- the learning curve --------------------------------------------------------
# training sets: the first N binaries, for N in SIZES; the envelopes of the
# last refinement (or "base" with REFINE_ITERATIONS=0)
SIZES="1024 2048 4096 8192 16384 32768 65536 131072 262144 524288 1048576"
# regressors trained at each size, "name|options" (validated on all of the
# validation set); kernel ridge only up to KRR_MAX binaries (3 N^2 8 bytes of
# memory, N^3 time: ~3 hours and 26 GB at 2^15). Other options of
# precession_scale.py train go in too, e.g. "mlp_wd|--mlp --mlp-weight-decay 1e-4"
SERIES=(
    "krr|"
    "mlp|--mlp --mlp-hidden 256 256 256 256"
    "mlp_wide|--mlp --mlp-hidden 512 512 512 512 512 512"
)
KRR_MAX=32768
# the perceptrons train for about MLP_STEPS steps whatever the size, in
# batches of 128 growing with it up to 1024 (see mlp_batch in submit.sh):
# on a laptop CPU 8.5 ms a step at 4x256 and 1024 (30 minutes), 35 at 6x512
MLP_STEPS=200000
TRAIN_CPUS=16
TRAIN_TIME=24:00:00
# e.g. "gpu:1" to train the perceptrons on a GPU (install jax[cuda12] in the
# environment first); CPUs are fast enough at these sizes
MLP_GRES=""

# module load ...
# export UV_CACHE_DIR=/scratch/$USER/uv-cache
