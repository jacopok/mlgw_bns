# Settings of slurm/modes/submit.sh and job.sh for default_hom_lambda4000
# (2.1): tidal deformabilities from just above 1 (TEOBResumS uses its BBH
# settings at 1 and below) up to 4000, drawn uniform in the binary tidal
# deformability and then along its lines of constant value, and the
# aligned spins uniform in chi_eff and then likewise (--sampling effective,
# EffectiveParameterGenerator). Kernel ridge in log(1 + Lambda), width 0.03, on 60
# principal components of 2^15 waveforms, validated on the stored
# validation set and end to end against TEOBResumS. Every walltime fits the
# 3-hour short partition. Run beside the others with
#   CLUSTER_ENV=slurm/modes/release_lambda4000.env slurm/modes/submit.sh
# (copy this to release_lambda4000.env, not committed, and edit it).
# The jobs source this file too: module loads and exports go here.
# Find your accounts and partitions with
#   sacctmgr show assoc user=$USER format=account%20,partition%15,qos%30
#   sinfo -s

SLURM_ACCOUNT=""            # -A; empty if your cluster has no accounts
SLURM_PARTITION="short"          # -p; empty for the default partition
SLURM_EXTRA=""              # any other sbatch options, e.g. "--qos=long --mail-type=FAIL"

# Where the datasets, models and logs go (36 kB a training waveform: 9.4 GB
# for 2^18), on a filesystem every node sees: scratch, not home.
DATA="$PWD/visualization/modes_scale/release_lambda4000"

# The python of the project's environment (uv sync --extra jax, with TEOBResumS), called
# directly so that signals reach it.
PYTHON=".venv/bin/python"

# SLURM signals the jobs this many seconds before their walltime: they
# checkpoint (or abandon the shard they are making) and are requeued, at most
# MAX_REQUEUES times each.
SIGNAL_LEAD=300
MAX_REQUEUES=20

# -- the datasets --------------------------------------------------------------
# The model is that of hom7_big (make_hom7_dataset.py): 7 modes from 5 Hz,
# q in [1, 3], |chi| < 0.5, here Lambda in [1.001, 4000].
N_TRAIN=32768               # 2^15
N_VALIDATION=16384          # 2^14, independent (another seed)
SHARD_SIZE=1024
LAMBDA_MAX=4000
LAMBDA_MIN=1.001
SAMPLING="effective"

# the downsampling indices of every mode, on DOWNSAMPLING_SIZE waveforms each
# (a few minutes), shared by the validation set
DOWNSAMPLING_SIZE=64
DOWNSAMPLING_CPUS=32
DOWNSAMPLING_MEM=64G
DOWNSAMPLING_TIME=02:00:00

# making the shards: tasks x cpus processes claim shards until none is left
# (~0.4 s a waveform a core: 2^15 + 2^14 is ~6 core-hours)
GENERATE_TASKS=4
GENERATE_CPUS=32
GENERATE_MEM=64G
GENERATE_TIME=02:50:00

# the principal components of every mode, on the first PCA_SIZE waveforms,
# shared by all the trainings (as Model.generate's PCA dataset): the first
# PCA_COMPONENTS of them (a train series using others, --pca-components,
# computes and saves its own)
PCA_SIZE=32768
PCA_COMPONENTS=60
PCA_CPUS=8
PCA_MEM=16G
PCA_TIME=01:00:00

# -- the learning curve --------------------------------------------------------
# training sets: the first N waveforms, for N in SIZES
SIZES="32768"
# regressors trained at each size, "name|options" (of modes_scale.py train);
# kernel ridge only up to KRR_MAX waveforms (~2 N^2 8 bytes of memory: 17 GB
# at 2^15), a job per mode, then a job validating
# the model on all of the validation set
SERIES=(
    "log60g003|--input-coordinates log_lambda --kernel-gamma 0.03 --pca-components 60"
)
KRR_MAX=32768
# the perceptrons train for about MLP_STEPS steps whatever the size, in
# batches of 128 growing with it up to 1024 (see mlp_batch in slurm/lib.sh):
# on a laptop CPU ~9 ms a step at 4x256 and 1024 (30 minutes), 35 at 6x512
MLP_STEPS=200000
# CPUs of a mode's training: kernel ridge (multithreaded BLAS), perceptrons
# (small batches: a few cores are enough)
TRAIN_CPUS=16
MLP_CPUS=4
TRAIN_TIME=02:50:00
# e.g. "gpu:1" to train the perceptrons on a GPU (install jax[cuda12] in the
# environment first); CPUs are fast enough at these sizes
MLP_GRES=""
VALIDATE_CPUS=32
VALIDATE_MEM=32G
VALIDATE_TIME=02:50:00

# -- end-to-end validation against TEOBResumS (submit.sh teob) -------------------
# visualization/validate_model.py on each model of TEOB_RUNS (default: every
# series and size): residuals, per-mode and full-waveform mismatches of
# TEOB_N waveforms a distribution, each a TEOBResumS call (minutes a hundred)
TEOB_N=1000
TEOB_RUNS="${TEOB_RUNS:-}"   # or from the environment, e.g. TEOB_RUNS=krr_16384 submit.sh teob
TEOB_CPUS=8
TEOB_MEM=16G
TEOB_TIME=02:50:00

# -- hyperparameter studies (submit.sh optimize) ---------------------------------
# "name|options" of modes_scale.py optimize: an optuna study per mode, in
# $DATA/optimize/<name>/, of perceptrons (--kind krr: kernel ridge, its width
# only) trained on the first --n waveforms for MLP_STEPS steps each, scored on
# the validation set. A perceptron costs the same whatever --n (its steps are
# fixed), and what is best depends on --n: search at the size the model will
# be trained on. --enqueue-from DIR seeds a study with the best trials of
# another as they start; --fix NAME=VALUE holds parameters of the search
# space; options here override the defaults (--workers, --mlp-steps).
# --prune-start F --prune-reduction R: successive halving from F of the steps,
# keeping 1/R at each rung (default 0.1, 3); a study keeps the settings it
# was started with, so other ones need another study name.
# submit.sh optimize HOURS runs each mode's study on a node for HOURS (a 4 x
# 256 perceptron takes ~15 minutes at batch 128 on 4 cores, wider ones and
# larger batches more); submitting it again continues the studies.
OPTIMIZE_STUDIES=(
    # kernel ridge, as optimize_n_hours.py (its width; its cost grows as N^3):
    # one worker, its linear algebra on all the cores
    # "krr_n16384|--kind krr --n 16384 --workers 1"
)
# submit.sh best: a model of each mode's best trial so far, or of kernel ridge
# on the first BEST_KRR_N waveforms (~2 N^2 8 bytes, minutes at 2^14) for the
# modes where that does as well on the study's objective
BEST_KRR_N=16384
OPTIMIZE_CPUS=16            # a job of this many cores per mode's study
OPTIMIZE_WORKERS=4          # trials at once in it, each on OPTIMIZE_CPUS / this many cores
OPTIMIZE_MEM=32G            # each worker reads the training set; kernel ridge: ~2 N^2 8 bytes

# module load ...
# export UV_CACHE_DIR=/scratch/$USER/uv-cache
