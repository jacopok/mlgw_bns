# Settings of slurm/modes/submit.sh and job.sh. Copy to cluster.env (not
# committed) and edit. The jobs source this file too: module loads and
# exports go here.
# Find your accounts and partitions with
#   sacctmgr show assoc user=$USER format=account%20,partition%15,qos%30
#   sinfo -s

SLURM_ACCOUNT=""            # -A; empty if your cluster has no accounts
SLURM_PARTITION=""          # -p; empty for the default partition
SLURM_EXTRA=""              # any other sbatch options, e.g. "--qos=long --mail-type=FAIL"

# Where the datasets, models and logs go (36 kB a training waveform: 9.4 GB
# for 2^18), on a filesystem every node sees: scratch, not home.
DATA="$PWD/visualization/modes_scale/run"

# The python of the project's environment (uv sync, with TEOBResumS), called
# directly so that signals reach it.
PYTHON=".venv/bin/python"

# SLURM signals the jobs this many seconds before their walltime: they
# checkpoint (or abandon the shard they are making) and are requeued, at most
# MAX_REQUEUES times each.
SIGNAL_LEAD=300
MAX_REQUEUES=20

# -- the datasets --------------------------------------------------------------
# The model is that of hom7_big (make_hom7_dataset.py): 7 modes from 5 Hz,
# q in [1, 3], |chi| < 0.5, Lambda in [5, 12000]. hom7_big trained on 24576
# waveforms (kernel ridge, PCA on 4096) and was validated on 100.
N_TRAIN=262144              # 2^18
N_VALIDATION=16384          # 2^14, independent (another seed)
SHARD_SIZE=1024
LAMBDA_MAX=12000

# the downsampling indices of every mode, on DOWNSAMPLING_SIZE waveforms each
# (a few minutes), shared by the validation set
DOWNSAMPLING_SIZE=64
DOWNSAMPLING_CPUS=32
DOWNSAMPLING_MEM=64G
DOWNSAMPLING_TIME=02:00:00

# making the shards: tasks x cpus processes claim shards until none is left
# (~1 s of TEOBResumS a waveform a core: 2^18 + 2^14 is ~80 core-hours)
GENERATE_TASKS=8
GENERATE_CPUS=32
GENERATE_MEM=64G
GENERATE_TIME=04:00:00

# the principal components of every mode, on the first PCA_SIZE waveforms,
# shared by all the trainings (as Model.generate's PCA dataset)
PCA_SIZE=32768
PCA_CPUS=8
PCA_MEM=16G
PCA_TIME=01:00:00

# -- the learning curve --------------------------------------------------------
# training sets: the first N waveforms, for N in SIZES
SIZES="4096 8192 16384 32768 65536 131072 262144"
# regressors trained at each size, "name|options" (of modes_scale.py train);
# kernel ridge only up to KRR_MAX waveforms (~2 N^2 8 bytes of memory: 69 GB
# at 2^16; N^3 time: hours at 2^16), a job per mode, then a job validating
# the model on all of the validation set
SERIES=(
    "krr|"
    "mlp|--mlp --mlp-hidden 256 256 256 256"
    "mlp_wide|--mlp --mlp-hidden 512 512 512 512 512 512"
)
KRR_MAX=65536
# the perceptrons train for about MLP_STEPS steps whatever the size, in
# batches of 128 growing with it up to 1024 (see mlp_batch in slurm/lib.sh):
# on a laptop CPU ~9 ms a step at 4x256 and 1024 (30 minutes), 35 at 6x512
MLP_STEPS=200000
# CPUs of a mode's training: kernel ridge (multithreaded BLAS), perceptrons
# (small batches: a few cores are enough)
TRAIN_CPUS=16
MLP_CPUS=4
TRAIN_TIME=24:00:00
# e.g. "gpu:1" to train the perceptrons on a GPU (install jax[cuda12] in the
# environment first); CPUs are fast enough at these sizes
MLP_GRES=""
VALIDATE_CPUS=32
VALIDATE_MEM=32G
VALIDATE_TIME=08:00:00

# module load ...
# export UV_CACHE_DIR=/scratch/$USER/uv-cache
